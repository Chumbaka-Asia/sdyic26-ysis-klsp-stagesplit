# Copy this file to ".env" (the setup script does this for you).

# Optional: lets Claude understand open-ended answers like donkey names.
# Get a key at https://console.anthropic.com  - leave blank to use keywords only.
ANTHROPIC_API_KEY=

# Claude model used to classify answers (small and fast is best here).
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Port for the local server.
PORT=8000

# Whisper: speech-to-text on this laptop, used to understand names children shout.
# Set to off to use only Chrome's built-in listening.
WHISPER=on
# Model size: base (fastest), small (default, good balance), medium (most accurate, slow).
WHISPER_MODEL=small

# The Studio and editor only work on this laptop, so phones used for voting can't
# change anything. Set to on to allow editing from other computers on the Wi-Fi.
ALLOW_REMOTE_EDITING=off
